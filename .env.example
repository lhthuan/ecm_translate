# Zalo Bot (from Zalo Bot Creator)
ZALO_BOT_TOKEN=123456789:abc-xyz
ZALO_WEBHOOK_SECRET_TOKEN=choose-a-secret-8-to-256-chars

# Gemini API (https://aistudio.google.com/)
# GEMINI_API_KEY: single key. Or use GEMINI_API_KEYS (comma-separated) to try
# multiple keys in order — useful if one key hits its quota.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key-one,key-two

# Primary model, plus a comma-separated fallback chain tried (same key, then
# next key) whenever the primary returns a 429/503/quota error OR a 404
# "no longer available" (Google has been retiring gemini-2.x models early).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite

# Optional: route generateContent calls through a relay (e.g. a Google Apps
# Script Web App) instead of calling Google directly. See MAINTENANCE.md
# section 4.3 for why this exists (Google has been blocking generateContent
# calls made from Vercel's serverless IP range with a 403) and how to set
# one up. Leave both unset to call the Gemini API directly as normal.
# GEMINI_PROXY_URL=https://script.google.com/macros/s/xxx/exec
# GEMINI_PROXY_SECRET=choose-a-secret

# Upstash Redis (set automatically when you add the Redis integration from Vercel Marketplace)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only needed for the local scripts/set-webhook.ts helper
PUBLIC_WEBHOOK_URL=https://your-deployment.vercel.app/api/webhook
