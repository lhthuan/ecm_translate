# Zalo Bot (from Zalo Bot Creator)
ZALO_BOT_TOKEN=123456789:abc-xyz
ZALO_WEBHOOK_SECRET_TOKEN=choose-a-secret-8-to-256-chars

# Gemini API (https://aistudio.google.com/)
# GEMINI_API_KEY: single key. Or use GEMINI_API_KEYS (comma-separated) to try
# multiple keys in order — useful if one key hits its quota.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_API_KEYS=key-one,key-two

# Primary model, plus a comma-separated fallback chain tried (same key, then
# next key) whenever the primary returns a 429/503/quota error OR a 404
# "no longer available" (Google has been retiring gemini-2.x models early).
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite

# Upstash Redis — REST URL/token from the Upstash console (or Cloudflare
# Workers secrets once deployed; this .env is only read by scripts/*.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Only needed for the local scripts/set-webhook.ts helper
PUBLIC_WEBHOOK_URL=https://your-worker.your-subdomain.workers.dev/api/webhook
