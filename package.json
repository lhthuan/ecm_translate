{
  "name": "ecm_translate",
  "version": "1.0.0",
  "private": true,
  "description": "Zalo Bot middleware (Cloudflare Worker) that translates messages via the Gemini API",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "set-webhook": "tsx scripts/set-webhook.ts",
    "delete-webhook": "tsx scripts/delete-webhook.ts",
    "webhook-info": "tsx scripts/webhook-info.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "@types/node": "^26.1.0",
    "dotenv": "^17.4.2",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.124.0"
  }
}
